# Flat node_modules so shared dev tooling (typescript, vitest, eslint) resolves from
# every workspace package without per-package duplication. Tradeoff: weaker dependency
# isolation than pnpm's default symlinked layout. Revisit when packages publish
# independently. See spec/architecture-decisions/ADR-0004-monorepo-and-tooling.md.
node-linker=hoisted
strict-peer-dependencies=false
auto-install-peers=true
