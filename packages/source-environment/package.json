{
  "name": "@inevitable/source-environment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cognitive Source Environment foundation — source identity, anchors, layers, progressive canonicalization (ADR-0032, CSE-002).",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint ."
  },
  "dependencies": {
    "@inevitable/events": "workspace:*",
    "@inevitable/protocols": "workspace:*",
    "@inevitable/shared": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
