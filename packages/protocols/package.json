{
  "name": "@inevitable/protocols",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Canonical COS protocol contracts: JSON Schemas (Draft 2020-12), schema registry, ajv validators, generated TypeScript types, conformance harness.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "default": "./src/schemas.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "codegen": "tsx scripts/codegen.ts",
    "validate:schemas": "tsx scripts/validate-schemas.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint ."
  },
  "dependencies": {
    "@inevitable/shared": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.3"
  }
}
