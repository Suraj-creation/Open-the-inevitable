{
  "name": "@uci/adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Engine and vendor adapters for the UCI core: the SQLite causal store (node:sqlite) and model faculties. Vendor types never cross this package.",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint ."
  },
  "dependencies": {
    "@uci/kernel": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
