# Copy to .env (gitignored) and fill in. The Surface Gateway (apps/api) and the CLI demo
# (apps/cli) load .env at startup and use Gemini when GEMINI_API_KEY is present, else the
# deterministic NullModelRuntime.
GEMINI_API_KEY=
